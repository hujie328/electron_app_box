{
  "name": "electron_app_box",
  "version": "1.0.0",
  "description": "Electron desktop application shell for wrapping web apps.",
  "main": "src/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-e": "electron-builder",
    "dev-e": "chcp 65001 >nul && nodemon --watch src --watch appStatic --ext js,json,html --exec electron .",
    "dev-e:once": "chcp 65001 >nul && electron ."
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "",
  "author": {
    "name": "hujie",
    "email": "hujie_0328@163.com"
  },
  "license": "ISC",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "koa": "^2.16.4",
    "koa-static": "^5.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "41.7.1",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10"
  },
  "build": {
    "appId": "com.example.app",
    "publish": {
      "provider": "generic",
      "url": "http://example.com"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis"
        }
      ],
      "artifactName": "${productName}_Setup_${version}.${ext}",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}

